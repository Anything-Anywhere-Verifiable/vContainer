# gen_init_cpio list of the built-in initramfs (CONFIG_INITRAMFS_SOURCE).
# Modes and owners come from here, every mtime from KBUILD_BUILD_TIMESTAMP.
# /dev/console: the kernel opens it for PID 1 before /init mounts devtmpfs.
# /newroot: the container's root, outside /run, which /init unmounts first.
# /work/out/init: copied there by scripts/build-image.sh.
dir /dev 0755 0 0
nod /dev/console 0600 0 0 c 5 1
dir /proc 0755 0 0
dir /sys 0755 0 0
dir /run 0755 0 0
dir /etc 0755 0 0
dir /newroot 0755 0 0
file /init /work/out/init 0755 0 0
