# vcontainer kernel miniconfig (Linux 6.18.57, x86_64).
#
# Consumed as:  make allnoconfig KCONFIG_ALLCONFIG=image/kernel.config
# allnoconfig turns every visible option off; this file turns back on only
# what the guest needs. image/check-config.sh then asserts that every value
# below, and every symbol in image/kernel.must-be-off, survived into the final
# .config (Kconfig silently drops a request whose dependencies are not met).
#
# Sections: (1) the spec list, (2) additions needed to boot, (3) workload ABI.
# Every line outside section (1) carries its reason.

# ---------------------------------------------------------------------------
# (1) Required by the design (DESIGN.md §4.1, §4.2)
# ---------------------------------------------------------------------------
CONFIG_64BIT=y
CONFIG_SMP=y
# c3-standard-176 is the largest C3 shape; 256 > 176 and <= 512 (the limit
# without CPUMASK_OFFSTACK).
CONFIG_NR_CPUS=256
CONFIG_EXPERT=y
CONFIG_MULTIUSER=y
CONFIG_SHMEM=y
CONFIG_POSIX_TIMERS=y
CONFIG_PROC_SYSCTL=y
CONFIG_FILE_LOCKING=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SYSVIPC=y
CONFIG_KALLSYMS=y
CONFIG_LOCALVERSION="-vcontainer"
CONFIG_DEFAULT_HOSTNAME="vcontainer"

# CPU / hypervisor / TEE
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_X86_X2APIC=y
CONFIG_CPU_SUP_INTEL=y
CONFIG_CPU_SUP_AMD=y
CONFIG_INTEL_TDX_GUEST=y
CONFIG_AMD_MEM_ENCRYPT=y
CONFIG_VIRT_DRIVERS=y
# Selects TSM_REPORTS (configfs-tsm quotes), TSM_MEASUREMENTS (RTMR sysfs)
# and CONFIGFS_FS. Listed explicitly so check-config.sh asserts them.
CONFIG_TDX_GUEST_DRIVER=y
CONFIG_TSM_REPORTS=y
CONFIG_TSM_MEASUREMENTS=y
CONFIG_CONFIGFS_FS=y

# Firmware interfaces
CONFIG_ACPI=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# Built-in command line; the boot loader's LoadOptions are ignored (D1).
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=ttyS0 noinitrd nopv panic=-1 efi=noruntime random.trust_bootloader=off ip=dhcp"
CONFIG_CMDLINE_OVERRIDE=y

# Built-in initramfs. scripts/build-image.sh writes this gen_init_cpio list;
# the path is inside the builder container, where the repo is mounted at /work.
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="/work/out/initramfs.list"
CONFIG_INITRAMFS_COMPRESSION_NONE=y

# Networking: gVNIC + kernel DHCP (ip=dhcp)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_GOOGLE=y
CONFIG_GVE=y

# Console
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_UNIX98_PTYS=y

# Filesystems and executables
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Isolation / hardening (D7)
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
# An empty path disables every usermode helper (core_pattern pipes,
# request_module, hotplug helper, ...).
CONFIG_STATIC_USERMODEHELPER=y
CONFIG_STATIC_USERMODEHELPER_PATH=""
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y

# ---------------------------------------------------------------------------
# (2) Additions needed to boot or to keep the kernel diagnosable
# ---------------------------------------------------------------------------
# BUG()/WARN() reporting. With BUG=n a failed kernel assertion becomes a
# silent hang and WARN_ON() prints nothing; we want an oops on ttyS0
# (and panic=-1 on panic) instead.
CONFIG_BUG=y

# Default-on hardening that allnoconfig silently drops. CPU_MITIGATIONS=n
# "disables all mitigations and CANNOT be overridden at runtime" (Kconfig
# help); D7 needs the workload kept out of /init's memory, so keep the stock
# defaults. Each mitigation still auto-detects at runtime, so CPUs that are
# not affected (e.g. Sapphire Rapids for MDS/L1TF) pay nothing.
CONFIG_CPU_MITIGATIONS=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_MITIGATION_RETHUNK=y
CONFIG_MITIGATION_UNRET_ENTRY=y
CONFIG_MITIGATION_CALL_DEPTH_TRACKING=y
CONFIG_MITIGATION_IBPB_ENTRY=y
CONFIG_MITIGATION_IBRS_ENTRY=y
CONFIG_MITIGATION_SRSO=y
CONFIG_MITIGATION_GDS=y
CONFIG_MITIGATION_RFDS=y
CONFIG_MITIGATION_SPECTRE_BHI=y
CONFIG_MITIGATION_MDS=y
CONFIG_MITIGATION_TAA=y
CONFIG_MITIGATION_MMIO_STALE_DATA=y
CONFIG_MITIGATION_L1TF=y
CONFIG_MITIGATION_RETBLEED=y
CONFIG_MITIGATION_SPECTRE_V1=y
CONFIG_MITIGATION_SPECTRE_V2=y
CONFIG_MITIGATION_SRBDS=y
CONFIG_MITIGATION_SSB=y
CONFIG_MITIGATION_ITS=y
CONFIG_MITIGATION_TSA=y
# Guard pages around kernel stacks (stack overflow -> oops, not corruption).
CONFIG_VMAP_STACK=y
# KASLR (physical + virtual) and per-syscall kernel stack offset. Runtime
# only: the PE file, and therefore RTMR1, is unchanged.
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_RANDOMIZE_KSTACK_OFFSET=y

# ---------------------------------------------------------------------------
# (3) Workload ABI: not needed to boot, but EXPERT=y + allnoconfig removes
# syscalls that ordinary linux/amd64 container images call (G1). Each one is
# a plain syscall with no host-facing surface.
# ---------------------------------------------------------------------------
# madvise/fadvise: glibc, jemalloc, Go, V8 and the JVM call madvise().
CONFIG_ADVISE_SYSCALLS=y
# membarrier(): used by .NET, V8/Node, liburcu.
CONFIG_MEMBARRIER=y
# rseq(): glibc >= 2.35 registers it at thread start.
CONFIG_RSEQ=y
# io_submit() & co (libaio): databases. io_uring stays off.
CONFIG_AIO=y
# inotify: file watchers in many runtimes and dev servers.
CONFIG_INOTIFY_USER=y
# Sub-jiffy nanosleep/timers; without it every sleep rounds up to 1/HZ.
CONFIG_HIGH_RES_TIMERS=y
# seccomp(2) filters: Chromium, Firefox, bubblewrap, systemd and libseccomp
# users fail hard without it. Classic BPF only; BPF_SYSCALL stays off.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
